#!/bin/sh
# pre-commit: единая версия кэш-баста для всех статических ассетов.
#
# Источник правды — маркер CACHE_VERSION в самом верху <head> index.html:
#   <!-- CACHE_VERSION: YYYYMMDD -->
#
# Триггер — любой .css/.js в коммите (кроме changelog.js, у него своя схема
# с Date.now()). Подстановка — любой .css/.js во всех html-файлах репозитория.
# Регистрировать новые файлы больше не нужно: под правило попадает всё.
# Изменённые файлы автоматически добавляются в этот же коммит.

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

TODAY=$(date +%Y%m%d)

# Тронут ли в этом коммите хоть один .css/.js?
STAGED=$(git diff --cached --name-only)
NEED_CHECK=$(printf '%s\n' "$STAGED" | grep -E '\.(css|js)$' | grep -vc '^changelog\.js$')
[ "$NEED_CHECK" = "0" ] && exit 0

MARKER=$(grep -oE '<!-- CACHE_VERSION: [0-9]{8}' index.html | grep -oE '[0-9]{8}')

if [ -z "$MARKER" ]; then
  echo "✗ pre-commit: не найден маркер <!-- CACHE_VERSION: YYYYMMDD --> в index.html"
  exit 1
fi

if [ "$MARKER" != "$TODAY" ]; then
  echo "✗ pre-commit: CACHE_VERSION в index.html = $MARKER, должен быть сегодняшний $TODAY"
  echo ""
  echo "  Поправь строку в index.html:"
  echo "    <!-- CACHE_VERSION: $TODAY -->"
  exit 1
fi

# changelog.js?v=' + Date.now() под шаблон не попадает: после ?v= там кавычка,
# а [0-9A-Za-z]+ требует хотя бы один буквенно-цифровой символ.
for f in $(git ls-files '*.html'); do
  [ -f "$f" ] || continue
  sed -i -E "s#(\.css|\.js)\?v=[0-9A-Za-z]+#\1?v=$MARKER#g" "$f"
  git add "$f"
done

exit 0
