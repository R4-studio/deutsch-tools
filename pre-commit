#!/bin/sh
# pre-commit: проверка ?v=YYYYMMDD у data.js И theme.css в HTML-файлах
# Должен соответствовать сегодняшней дате.
# Файлы/ассеты, где версия не в формате даты (напр. i18n/*.js?v=N), пропускаются —
# это отдельная, более простая схема версионирования, дата тут не при чём.

TODAY=$(date +%Y%m%d)
REPO_ROOT=$(git rev-parse --show-toplevel)
FAIL=0
BAD_FILES=""

for f in "$REPO_ROOT"/*.html; do
  [ -f "$f" ] || continue
  # Ищем все вхождения data.js?v=XXXXXXXX и theme.css?v=XXXXXXXX
  VERSIONS=$(grep -oE '(data\.js|theme\.css)\?v=[0-9]{8}' "$f" | sed -E 's/(data\.js|theme\.css)\?v=//' | sort -u)
  [ -z "$VERSIONS" ] && continue
  for V in $VERSIONS; do
    if [ "$V" != "$TODAY" ]; then
      NAME=$(basename "$f")
      echo "  ✗ $NAME: ?v=$V  →  должно быть ?v=$TODAY"
      BAD_FILES="$BAD_FILES $NAME"
      FAIL=1
    fi
  done
done

if [ "$FAIL" = "1" ]; then
  echo ""
  echo "Версия data.js/theme.css в HTML не совпадает с сегодняшней датой ($TODAY)."
  echo ""
  echo "Команда для починки (запусти в git bash из корня репо):"
  echo ""
  echo "  sed -i -E 's/(data\\.js|theme\\.css)\\?v=[0-9]{8}/\\1?v=$TODAY/g'$BAD_FILES"
  echo ""
  echo "Или вручную найди и замени строку в указанных файлах."
  exit 1
fi

exit 0
